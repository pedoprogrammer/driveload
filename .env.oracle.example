# Public hostname pointed to the Oracle VM. Do not include https://.
DOMAIN=driveload.example.com
APP_URL=https://driveload.example.com

# Use long random alphanumeric values. Keep this file private.
SECRET_KEY=replace-with-a-random-secret
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql+psycopg2://driveload:replace-with-a-random-database-password@db:5432/driveload

TEMP_DOWNLOAD_DIR=/var/lib/driveload/downloads
FREE_LIMIT=3

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_PLAN_ID=

STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

